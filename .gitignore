# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
*.p12
*.pfx
*.tmp
*.log
/tmp/
/temp/
# Never restore the unsanitized management screenshot to the public asset directory.
/public/product/campus-gestion.png

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# Credenciales de cuentas de servicio: nunca versionar el JSON descargado.
/credentials/
*service-account*.json
*credentials*.json
*google-key*.json
*-key-*.json
# Los nombres de las claves de Google pueden ser arbitrarios: JSON excluido por defecto.
*.json
!package.json
!package-lock.json
!tsconfig.json
!docs/capturas/revision.json
/test-results/
/playwright-report/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
