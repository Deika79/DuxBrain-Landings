# Copiar como .env.local. Todo se usa exclusivamente en servidor.
SMTP_HOST=smtp.ionos.es
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Dirección de buzón autorizada, sin nombre de presentación.
SMTP_FROM=
LEADS_NOTIFICATION_TO=info@duxbrain.ai

GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Entre comillas; admite saltos literales o secuencias \n del JSON descargado.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SPREADSHEET_ID=17E_ejZKmoQYxw1xzY_0e3QK-kNtB-4kJY7D7DVX733c
GOOGLE_SHEET_ID=897385192
GOOGLE_SHEET_NAME="CP David Parte 2"
# PENDIENTE: número de fila de las cabeceras, sin valor por defecto.
GOOGLE_SHEET_HEADER_ROW=
# PENDIENTE: valor comercial permitido por la validación de lead_status.
LEADS_INITIAL_STATUS=
# Bloqueo explícito hasta confirmar estructura y realizar la prueba autorizada.
LEADS_SHEETS_WRITES_ENABLED=false
# Mapeo A:T confirmado en código; no crear ni cambiar columnas.

APP_URL=http://localhost:3000
# Redis persistente (Upstash REST): rate limit e idempotencia entre instancias.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Secreto aleatorio de al menos 32 caracteres para HMAC de IP y payload.
LEADS_HASH_SECRET=
# Cabecera IP que el alojamiento/proxy sobrescribe de forma fiable.
# Obligatoria en producción; nunca confiar ciegamente en x-forwarded-for.
LEADS_TRUSTED_IP_HEADER=
